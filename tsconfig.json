{
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "es2021",
		"outDir": "out",
		"lib": [
			"es6"
		],
		"sourceMap": true,
		"rootDir": "src",
		
	},
